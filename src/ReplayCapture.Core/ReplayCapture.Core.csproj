<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ReplayCapture.Core</RootNamespace>
    <!-- Writes CsWin32's generated interop to obj/generated so the exact signatures are readable. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
    <!-- Warm-up for the Native AOT migration: surfaces IL2026/IL3050-class trim/AOT analyzer
         warnings during ordinary builds, ahead of the CsWin32/CsWinRT COM interop remediation. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- The process/track rules engine is internal but is exactly the logic worth testing. -->
    <InternalsVisibleTo Include="ReplayCapture.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Precompiled at build time is unnecessary here — fxc output is checked in directly since the
         cursor-blit shader never changes. Compiling via D3DCompiler at runtime would just add a
         native dependency for no benefit. -->
    <EmbeddedResource Include="Capture\Shaders\CursorBlitVS.cso" LogicalName="ReplayCapture.Core.Capture.Shaders.CursorBlitVS.cso" />
    <EmbeddedResource Include="Capture\Shaders\CursorBlitPS.cso" LogicalName="ReplayCapture.Core.Capture.Shaders.CursorBlitPS.cso" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Sdcb.FFmpeg" Version="7.0.0" />
    <PackageReference Include="Sdcb.FFmpeg.runtime.windows-x64" Version="7.1.0" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.298">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
