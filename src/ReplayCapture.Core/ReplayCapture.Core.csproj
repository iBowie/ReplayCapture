<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ReplayCapture.Core</RootNamespace>
    <!-- Writes CsWin32's generated interop to obj/generated so the exact signatures are readable. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
    <!-- Warm-up for the Native AOT migration: surfaces IL2026/IL3050-class trim/AOT analyzer
         warnings during ordinary builds, ahead of the CsWin32/CsWinRT COM interop remediation. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- The process/track rules engine is internal but is exactly the logic worth testing. -->
    <InternalsVisibleTo Include="ReplayCapture.Tests" />
  </ItemGroup>

  <!-- Windows-only sources: DXGI/WGC capture, D3D11 encode, WASAPI audio, and the ReplaySession
       composition root that wires them together. Excluded from the bare net10.0 (Linux) leg so it
       never references Vortice/CsWin32/WinRT types at all — a Linux capture/encode/audio backend
       and its own composition root land here in later phases. -->
  <ItemGroup Condition="!$(TargetFramework.Contains('windows'))">
    <Compile Remove="Capture\Windows\**\*.cs" />
    <Compile Remove="Encoders\Windows\**\*.cs" />
    <Compile Remove="Audio\Windows\**\*.cs" />
    <Compile Remove="Windows\**\*.cs" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.Contains('windows'))">
    <!-- Precompiled at build time is unnecessary here — fxc output is checked in directly since the
         cursor-blit shader never changes. Compiling via D3DCompiler at runtime would just add a
         native dependency for no benefit. -->
    <EmbeddedResource Include="Capture\Shaders\CursorBlitVS.cso" LogicalName="ReplayCapture.Core.Capture.Shaders.CursorBlitVS.cso" />
    <EmbeddedResource Include="Capture\Shaders\CursorBlitPS.cso" LogicalName="ReplayCapture.Core.Capture.Shaders.CursorBlitPS.cso" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared codec/mux bindings on both TFMs. No Linux runtime package exists yet (verified: no
         Sdcb.FFmpeg.runtime.linux-x64 on NuGet) — the Linux leg compiles against this reference
         package only and resolves the native libraries at runtime via
         DynamicallyLoadedBindings.LibrariesPath pointed at the distro's system FFmpeg, once a Linux
         backend actually calls into it. -->
    <PackageReference Include="Sdcb.FFmpeg" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.Contains('windows'))">
    <PackageReference Include="Sdcb.FFmpeg.runtime.windows-x64" Version="7.1.0" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.298">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
