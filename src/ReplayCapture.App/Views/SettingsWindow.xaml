<Window x:Class="ReplayCapture.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReplayCapture settings"
        Width="780" Height="620"
        MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Background="#FF1B1D21" Foreground="#FFE8EAED">

    <Window.Resources>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF3E6FDB" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FF3C4043" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFE8EAED" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE8EAED" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF9AA0A6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFE8EAED" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,5" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF25282D" />
            <Setter Property="Foreground" Value="#FFE8EAED" />
            <Setter Property="BorderBrush" Value="#FF3C4043" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FF25282D" />
            <Setter Property="Foreground" Value="#FFE8EAED" />
            <Setter Property="BorderBrush" Value="#FF3C4043" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="20" />
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Data="M0,0 L4,4 L8,0 Z" Fill="#FFE8EAED"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder" Background="#FF25282D" BorderBrush="#FF3C4043"
                                        BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#FFE8EAED" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF33363B" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF3E6FDB" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF35507A" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#FFE8EAED" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF33363B" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF3E6FDB" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="90" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#FF25282D" />
            <Setter Property="Foreground" Value="#FFE8EAED" />
            <Setter Property="BorderBrush" Value="#FF3C4043" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#FF33363B" />
            <Setter Property="RowBackground" Value="#FF25282D" />
            <Setter Property="AlternatingRowBackground" Value="#FF212429" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FF1B1D21" />
            <Setter Property="Foreground" Value="#FFE8EAED" />
            <Setter Property="BorderBrush" Value="#FF3C4043" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <DataGridCellsPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF2E3136" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF3E6FDB" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="#FF1B1D21" BorderBrush="#FF3C4043">

            <!-- ============================ General ============================ -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Buffer length (seconds)" />
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                            <TextBox Width="80" Text="{Binding BufferSeconds, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="12,0,0,0" Style="{StaticResource Hint}"
                                       Text="{Binding EstimatedMemory}" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Hotkey" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                            <TextBox x:Name="HotkeyBox" Width="200" IsReadOnly="True"
                                     Text="{Binding Hotkey, Mode=TwoWay}"
                                     PreviewKeyDown="OnHotkeyKeyDown"
                                     ToolTip="Click here and press the key combination" />
                            <TextBlock Margin="12,0,0,0" Style="{StaticResource Hint}"
                                       Text="Click, then press a combination" />
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Save clips to" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                            <TextBox Width="400" Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="Browse…" Margin="8,0,0,0" MinWidth="80" Click="OnBrowse" />
                        </StackPanel>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Memory cap (MB)" />
                        <TextBox Grid.Row="3" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,4"
                                 Text="{Binding MaxRingMemoryMegabytes, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Indicator corner" />
                        <ComboBox Grid.Row="4" Grid.Column="1" Width="160" HorizontalAlignment="Left" Margin="0,4"
                                  ItemsSource="{Binding OverlayCorners}"
                                  SelectedItem="{Binding OverlayCorner}" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Capture backend" />
                        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                            <ComboBox Width="120" ItemsSource="{Binding CaptureBackends}"
                                      SelectedItem="{Binding CaptureBackend}" />
                        </StackPanel>
                        <TextBlock Grid.Row="6" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource Hint}"
                                   Text="Dxgi (Desktop Duplication) delivers a high-refresh display's full native rate but runs a polling thread per display that never fully idles. Wgc (Windows.Graphics.Capture) is event-driven and costs nothing while the screen is static, but was measured capping delivery around 50 fps on a 200Hz panel regardless of load — fine for 60Hz-or-lower or mostly-idle displays, wrong for a high-refresh one." />

                        <CheckBox Grid.Row="7" Grid.Column="1" Content="Start with Windows (elevated, via Task Scheduler)"
                                  IsChecked="{Binding StartWithWindows}" />
                        <CheckBox Grid.Row="8" Grid.Column="1" Content="Show the armed indicator on screen"
                                  IsChecked="{Binding ShowOverlayIndicator}" />
                        <CheckBox Grid.Row="9" Grid.Column="1" Content="Play a sound when a clip is saved"
                                  IsChecked="{Binding PlaySoundOnSave}" />

                        <TextBlock Grid.Row="10" Grid.Column="1" Margin="0,14,0,0" Style="{StaticResource Hint}"
                                   Text="The indicator is excluded from capture, so it never appears in saved clips. It cannot draw over a true fullscreen-exclusive game — the tray icon and save sound cover that case." />

                        <TextBlock Grid.Row="11" Grid.Column="1" Margin="0,10,0,0" Style="{StaticResource Hint}"
                                   Text="Changing the buffer length, displays, audio tracks or capture backend restarts the capture pipeline. The buffer is empty for a few seconds afterwards." />
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ============================ Displays ============================ -->
            <TabItem Header="Displays">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Margin="0,0,0,10" Style="{StaticResource Hint}"
                               Text="Each enabled display is captured as its own video stream at its native resolution and written to its own .mov file. Leave FPS as 'auto' to follow the display's refresh rate." />

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Displays}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="44" />
                            <DataGridTextColumn Header="Display" Binding="{Binding Description}" IsReadOnly="True" Width="*" />
                            <DataGridTextColumn Header="FPS" Binding="{Binding Fps, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                            <DataGridTextColumn Header="Mbps" Binding="{Binding BitrateMbps, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ============================ Audio ============================ -->
            <TabItem Header="Audio tracks">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10" Style="{StaticResource Hint}"
                               Text="Every track becomes a separate audio stream in each saved file. There is no limit on the number of tracks." />

                    <ListBox Grid.Row="1" Grid.Column="0" Margin="0,0,12,0"
                             Background="#FF25282D" Foreground="#FFE8EAED" BorderBrush="#FF3C4043"
                             ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}"
                             DisplayMemberPath="Name" />

                    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Add" MinWidth="70" Command="{Binding AddTrackCommand}" />
                        <Button Content="Remove" MinWidth="70" Command="{Binding RemoveTrackCommand}" />
                    </StackPanel>

                    <Grid Grid.Row="1" Grid.Column="1" DataContext="{Binding SelectedTrack}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <TextBlock Text="Name" Width="52" />
                            <TextBox Width="220" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Gain" Width="46" Margin="16,0,0,0" />
                            <TextBox Width="60" Text="{Binding Gain, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox Content="Enabled" Margin="16,0,0,0" IsChecked="{Binding Enabled}" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Margin="0,12,0,4" Style="{StaticResource Hint}"
                                   Text="Sources, one per line:   device:render:default   ·   device:capture:default   ·   proc:spotify.exe   ·   proc:!discord.exe   ·   proc:*   ·   group:comms   ·   group:!comms" />

                        <TextBox Grid.Row="2" AcceptsReturn="True" FontFamily="Cascadia Mono, Consolas"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding SourcesText, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Grid Grid.Row="2" Grid.Column="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0" ItemsSource="{Binding RunningAudioProcesses}"
                                  SelectedItem="{Binding SelectedProcess}"
                                  ToolTip="Processes currently playing audio" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Content="↻" MinWidth="34" Command="{Binding RefreshProcessesCommand}"
                                    ToolTip="Refresh the list" />
                            <Button Content="Add to track" MinWidth="100" Command="{Binding AddProcessToTrackCommand}" />
                            <Button Content="Exclude elsewhere" MinWidth="130"
                                    Command="{Binding ExcludeProcessFromCatchAllCommand}"
                                    ToolTip="Add an exclusion on every track using proc:*, so this app is not captured twice" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ============================ Process groups ============================ -->
            <TabItem Header="Process groups">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10" Style="{StaticResource Hint}"
                               Text="Named sets of executables, so a track's Sources can say group:comms (or group:!comms to exclude) instead of listing every app with proc:." />

                    <ListBox Grid.Row="1" Grid.Column="0" Margin="0,0,12,0"
                             Background="#FF25282D" Foreground="#FFE8EAED" BorderBrush="#FF3C4043"
                             ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"
                             DisplayMemberPath="Name" />

                    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Add" MinWidth="70" Command="{Binding AddGroupCommand}" />
                        <Button Content="Remove" MinWidth="70" Command="{Binding RemoveGroupCommand}" />
                    </StackPanel>

                    <Grid Grid.Row="1" Grid.Column="1" DataContext="{Binding SelectedGroup}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <TextBlock Text="Name" Width="52" />
                            <TextBox Width="220" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Margin="0,12,0,4" Style="{StaticResource Hint}"
                                   Text="Member executables, one per line, e.g. discord.exe. Accepts * and ? wildcards, matched case-insensitively." />

                        <TextBox Grid.Row="2" AcceptsReturn="True" FontFamily="Cascadia Mono, Consolas"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding MembersText, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="1" Margin="4,12,4,0" Foreground="#FFE5484D" TextWrapping="Wrap"
                   Text="{Binding ValidationError}" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Click="OnCancel" />
            <Button Content="Save" Click="OnSave" Margin="0" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
