<Window x:Class="ReplayCapture.App.Overlay.IndicatorWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReplayCapture indicator"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        ShowActivated="False"
        IsHitTestVisible="False">

    <Border x:Name="Root"
            CornerRadius="7"
            Padding="11,6"
            Background="#D9101215"
            BorderBrush="#40FFFFFF"
            BorderThickness="1">
        <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="Dot" Width="9" Height="9" Fill="#E5484D"
                     VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock x:Name="Label"
                       Text="REC"
                       Foreground="#F2F4F6"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</Window>
